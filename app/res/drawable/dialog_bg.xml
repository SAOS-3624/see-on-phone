<?xml version="1.0" encoding="utf-8"?>
<!--
    对话框底板：圆角 20dp + 卡片色。

    为什么这个留在 xml 而不是 Theme.java：`alertDialogTheme` 的 `windowBackground`
    必须是**资源引用**，代码里拿不到那个 hook（系统在 inflate 对话框窗口时直接读主题）。
    它只有四个值，不会漂。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#121826" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#243149" />
</shape>
