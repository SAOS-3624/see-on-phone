{
  "name": "dsh-see-on-phone",
  "version": "2.1.1",
  "description": "鱼眼 · See on Phone — 让 AI 住进手机：在手机上直接和模型聊天，需要时用它自己的摄像头看世界（手机端取帧、挑帧、拼宫格，电脑只收一张图）。导盲只是其中一个可选读者。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "camera",
    "phone",
    "vision",
    "accessibility",
    "navigation",
    "termux",
    "token-efficient"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./guide": "./src/guide.js",
    "./mode": "./src/mode.js",
    "./phone": "./src/phone.js",
    "./tool-spec": "./src/tool-spec.js"
  },
  "files": [
    "src",
    "scripts",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "CREDITS.md",
    "NOTICE",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "smoke:file": "node scripts/smoke.mjs file 12",
    "check:syntax": "node scripts/check-syntax.mjs",
    "prepublishOnly": "node scripts/check-syntax.mjs && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "SAOS-3624",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAOS-3624/see-on-phone.git"
  }
}
